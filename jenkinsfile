pipeline {
    agent any
    stages {
        stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/Saranya2308/github.io.git'
            }
        }
        stage('Show HTML Output') {
            steps {
                powershell 'Select-String "<h1>(.*?)</h1>" index.html | ForEach-Object { $_.Matches[0].Groups[1].Value }'
                powershell 'Select-String "Hello, World!" index.html'
            }
        }
        stage('Deploy') {
            steps {
                script {
                    // Define the deployment path
                    def deployPath = 'C:\\Users\\<YourUsername>\\Desktop\\DeployedSite\\'
                    
                    // Create the folder if it doesn't exist
                    bat """
                    if not exist "${deployPath}" mkdir "${deployPath}"
                    copy index.html "${deployPath}"
                    """
                }
            }
        }
    }
}
